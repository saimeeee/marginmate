{
  "manifest_version": 3,
  "name": "MarginMate",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Bring a selected passage into a private prompt desk. Explain, translate, rewrite, or ask a local model.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Bring selection to MarginMate",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://localhost:* http://127.0.0.1:*; base-uri 'none';"
  }
}
